{
  "name": "fastop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Find products in any kind of shop and see them on a map.",
  "scripts": {
    "dev": "vite",
    "api": "node --watch --env-file-if-exists=.env server/index.js",
